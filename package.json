{
    "name": "@hipo-finance/mcp",
    "version": "0.1.0",
    "description": "MCP server exposing Hipo liquid staking documentation and live on-chain data",
    "license": "MIT",
    "type": "module",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/HipoFinance/mcp.git"
    },
    "homepage": "https://github.com/HipoFinance/mcp#readme",
    "bugs": {
        "url": "https://github.com/HipoFinance/mcp/issues"
    },
    "bin": {
        "hipo-mcp": "dist/stdio.js"
    },
    "main": "dist/server.js",
    "files": [
        "dist"
    ],
    "publishConfig": {
        "access": "public"
    },
    "scripts": {
        "build": "tsc",
        "start": "node dist/http.js",
        "start:stdio": "node dist/stdio.js",
        "test": "npm run build && node --test \"dist/**/*.test.js\"",
        "prepublishOnly": "npm run build"
    },
    "dependencies": {
        "@hipo-finance/sdk": "^4.1.0",
        "@modelcontextprotocol/sdk": "^1.29.0",
        "@ton/core": "^0.63.1",
        "@ton/crypto": "^3.3.0",
        "@ton/ton": "^16.3.0",
        "express": "^5.2.1",
        "zod": "^4.4.3"
    },
    "devDependencies": {
        "@types/express": "^5.0.6",
        "@types/node": "^26.1.1",
        "typescript": "^7.0.2"
    }
}
